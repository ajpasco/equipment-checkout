# Every setting the stack reads (blueprint section 6). Copy this file to `.env` beside it, which is
# git-ignored, and replace the placeholders; Compose reads `.env` from this folder.

# The `db` container. Required.
POSTGRES_USER=equipment
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=equipment

# The API's one setting. Required. It must begin postgresql+psycopg:// and name the host `db` and
# port 5432, because the API reads it inside the Compose network. Its user, password and database
# are the three above.
DATABASE_URL=postgresql+psycopg://equipment:CHANGE_ME@db:5432/equipment

# The port on this machine's loopback where the application is served. Optional, default 8080.
WEB_PORT=8080

# Where the client sends its API calls, a build value of the client and never a secret. Optional,
# default /api, which nginx passes to the API on the same origin.
VITE_API_BASE_URL=/api
